# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Required for live payments: Stripe Secret Key (sk_test_... or sk_live_...)
# Leave blank to run in Demo Unlock mode while testing locally.
STRIPE_SECRET_KEY=

# Optional: Price in cents (defaults to 900 = $9.00)
REPORT_PRICE_CENTS=900

# Optional: Canonical public URL (auto-detected if omitted; set in production e.g. https://clickdebt.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Secret used to sign HttpOnly unlock receipt cookies
UNLOCK_SIGNING_SECRET=change_this_to_a_random_32_char_string
